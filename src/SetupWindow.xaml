<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Mirror Setup" Width="640" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource Text}" Background="{DynamicResource Canvas}" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="30,28,30,24">
      <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="88" Height="88" CornerRadius="8" Background="{DynamicResource Input}"><Image x:Name="SetupBrand" Width="80" Height="80"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"><TextBlock Text="Android Mirror" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Android Mirror contributors" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/><TextBlock Text="Version 1.1.0 · Windows 10 / 11" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
      </Grid>
      <TextBlock x:Name="SetupHeading" Text="Ready to install" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="SetupStatus" Text="Mirror your Android devices from this PC." Foreground="{DynamicResource Muted}" LineHeight="20" Margin="0,9,0,0"/>
      <ProgressBar x:Name="SetupProgress" Minimum="0" Maximum="100" Value="0" Height="4" Visibility="Collapsed" Margin="0,20,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Input}">
        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/></Grid></ControlTemplate></ProgressBar.Template>
      </ProgressBar>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource DialogFooter}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="30,20,30,24">
      <StackPanel>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Install location" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SetupPath" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <CheckBox x:Name="DesktopShortcut" Content="Desktop shortcut" FontSize="13" VerticalAlignment="Center"/>
          <Button x:Name="SetupCancel" Grid.Column="1" Content="Cancel" MinWidth="100" Margin="12,0,8,0" Background="{DynamicResource Input}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Stroke}"/>
          <Button x:Name="SetupAction" Grid.Column="2" Content="Install" MinWidth="100"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
